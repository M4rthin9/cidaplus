# Copy to .env for local work. .env is gitignored — never commit real secrets.
# Contract enforced by src/lib/env.ts (SPEC.md §11); the app refuses to boot if
# anything below marked required is missing or malformed.

# --- required ---------------------------------------------------------------
DATABASE_URL=postgres://cida:cida@db:5432/cida

# At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-0123456789abcdef0123456789abcdef

AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where uploaded media and its derivatives live. Backed by a named volume.
MEDIA_DIR=/data/media

# Bootstrap value only. Once settings.line holds a row, the database wins.
# The URL must appear nowhere else in the codebase (SPEC.md §8).
LINE_OA_URL=https://line.me/ti/p/%40355kxfoj

# --- optional ---------------------------------------------------------------
# SMTP is NOT provisioned yet, and unset is the expected state. The contact form
# persists the enquiry to the database first and succeeds regardless (SPEC.md §9).
# Locally, docker-compose.dev.yml runs mailpit — uncomment to exercise the path.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@cidapt.com

# --- production only --------------------------------------------------------
# Set in /opt/cidaplus/.env on the server; not used for local work.
#
# The image tag deploy.sh runs. It rewrites this line on every deploy, which is
# what makes "roll back to the previous image" a one-command operation.
# WEB_IMAGE=ghcr.io/m4rthin9/cidaplus:sha-abc1234
#
# Postgres password for the db container. DATABASE_URL is composed from it in
# docker-compose.yml, so it is not set twice.
# POSTGRES_PASSWORD=
#
# CLOUDFLARE_API_TOKEN is deliberately absent. Origin TLS is a Cloudflare Origin
# Certificate installed at /opt/cidaplus/certs (SPEC.md §14 decision 30), so
# there is no ACME challenge and no token to leak.
