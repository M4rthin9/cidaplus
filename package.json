{
  "name": "cidaplus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@node-rs/argon2": "2.2.0",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "blurhash": "2.0.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.2",
    "nodemailer": "7.0.10",
    "postgres": "3.4.9",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.57.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
